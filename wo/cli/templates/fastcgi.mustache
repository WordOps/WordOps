# FastCGI cache settings
# Stored on disk: /run is a small tmpfs and a 256M cache fills up in a few hours.
# /var/run/nginx-cache is kept as a symlink to this directory (nginx-helper default path).
fastcgi_cache_path /var/cache/nginx-fastcgi levels=1:2 keys_zone=WORDPRESS:100m inactive=7d max_size=2g use_temp_path=off;
# $wpfc_cache_uri ($request_uri without analytics/ads parameters) is set in map-wp-fastcgi-cache.conf
fastcgi_cache_key "$scheme$request_method$host$wpfc_cache_uri";
fastcgi_cache_use_stale error timeout invalid_header updating http_500 http_503;
fastcgi_cache_lock on;
fastcgi_cache_lock_age 5s;
fastcgi_cache_lock_timeout 5s;
fastcgi_cache_methods GET HEAD;
fastcgi_cache_background_update on;
# Errors are not cached: a transient 5xx must not be served to other visitors.
# fastcgi_cache_use_stale above still serves the last good copy on backend errors.
fastcgi_cache_valid 200 24h;
fastcgi_cache_valid 301 302 30m;
fastcgi_cache_valid 404 1h;
fastcgi_buffers 16 16k;
fastcgi_buffer_size 32k;
fastcgi_param SERVER_NAME $http_host;
fastcgi_ignore_headers Cache-Control Expires Set-Cookie;
fastcgi_keep_conn on;
# only available with Nginx 1.15.6 and earlier
fastcgi_socket_keepalive on;
